<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3, unpackaged and self-contained (no MSIX, no separate runtime install). Windows only: build and run it on
       Windows with   dotnet build src\BookSearch.App -p:Platform=x64   or use windows\BookSearch.Windows.sln. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>BookSearch.App</RootNamespace>
    <AssemblyName>BookSearch</AssemblyName>
    <ApplicationIcon>Assets\Docent.ico</ApplicationIcon>
    <Product>Docent</Product>
    <AssemblyTitle>Docent</AssemblyTitle>
    <Description>Docent</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The icon file also goes next to the program, for the window's title bar and taskbar button (MainWindow). -->
    <Content Include="Assets\Docent.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookSearch.App.Logic\BookSearch.App.Logic.csproj" />
  </ItemGroup>

</Project>

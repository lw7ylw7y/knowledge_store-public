<Page
    x:Class="BookSearch.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:BookSearch.App">

    <!-- Background="Transparent" lets the empty parts of the page receive a drop. -->
    <Grid Padding="32" RowSpacing="12" AllowDrop="True" Background="Transparent"
          DragOver="Page_DragOver" Drop="Page_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The header: the title, then a command bar whose left part is the find box. The bar is in the star column, so what does
             not fit moves behind "...". In selection mode the commands are "Add tags to N books" and "Cancel". -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock x:Uid="LibraryTitle" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False"
                        HorizontalAlignment="Stretch" OverflowButtonVisibility="Auto">
                <CommandBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                        <TextBlock Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind ViewModel.IsSelecting, Mode=OneWay}" />
                        <TextBox x:Uid="LibraryFindBox" Width="240" Text="{x:Bind ViewModel.FindText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{x:Bind ViewModel.HasBooks, Mode=OneWay}" />
                    </StackPanel>
                </CommandBar.Content>
                <!-- While the library is empty the accent button in the empty state does the adding. -->
                <AppBarButton x:Uid="LibraryAddBarButton" Icon="Add" Click="Add_Click"
                              Visibility="{x:Bind ViewModel.ShowBrowseCommands, Mode=OneWay}" />
                <AppBarButton x:Uid="LibrarySelectBarButton" Icon="SelectAll" Command="{x:Bind ViewModel.SelectCommand}"
                              Visibility="{x:Bind ViewModel.ShowBrowseCommands, Mode=OneWay}" />
                <AppBarButton Label="{x:Bind ViewModel.AddTagsLabel, Mode=OneWay}" Icon="Tag"
                              Command="{x:Bind ViewModel.AddTagsToSelectedCommand}"
                              Visibility="{x:Bind ViewModel.IsSelecting, Mode=OneWay}" />
                <AppBarButton x:Uid="LibraryCancelBarButton" Icon="Cancel" Command="{x:Bind ViewModel.CancelSelectionCommand}"
                              Visibility="{x:Bind ViewModel.IsSelecting, Mode=OneWay}" />
            </CommandBar>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar Severity="Warning" CloseButtonClick="ElevationBar_CloseButtonClick"
                     IsOpen="{x:Bind ViewModel.HasElevationNotice, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ElevationNotice, Mode=OneWay}" />
            <InfoBar Severity="Warning" CloseButtonClick="BannerBar_CloseButtonClick"
                     IsOpen="{x:Bind ViewModel.HasBanner, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Banner, Mode=OneWay}" />
            <InfoBar Severity="Informational" CloseButtonClick="NoticeBar_CloseButtonClick"
                     IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                     Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}" />
        </StackPanel>

        <!-- One strip says what indexing is doing, instead of a progress bar on every row. -->
        <Border Grid.Row="2" Padding="14,6" CornerRadius="4" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.ShowIndexingStrip, Mode=OneWay}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <TextBlock Text="{x:Bind ViewModel.IndexingText, Mode=OneWay}" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.IndexingPercent, Mode=OneWay}"
                             VerticalAlignment="Center" MaxWidth="320" HorizontalAlignment="Left"
                             AutomationProperties.Name="{x:Bind ViewModel.IndexingText, Mode=OneWay}" />
                <Button Grid.Column="2" Content="{x:Bind ViewModel.PauseLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.TogglePauseCommand}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Spacing="8" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <TextBlock x:Uid="LibraryEmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Uid="LibraryEmptyBody" TextWrapping="Wrap" />
            <TextBlock x:Uid="LibraryDropHint" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <!-- The page's accent button while the library is empty; once there are books, reading them is the main action. -->
            <Button x:Uid="LibraryAddButton" Style="{StaticResource AccentButtonStyle}" Click="Add_Click" />
        </StackPanel>
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.NoMatchText, Mode=OneWay}" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{x:Bind ViewModel.NothingFound, Mode=OneWay}" />

        <!-- Reading is the Library's main job (ST-35): a click or Enter on a row does what its button does. In selection mode a click
             ticks the row. The row keeps one button; Tags... and Remove are in its "..." menu (also its context menu). -->
        <ListView x:Name="BookList" x:Uid="LibraryBookList" Grid.Row="4" ItemsSource="{x:Bind ViewModel.Shown}" SelectionMode="None"
                  IsItemClickEnabled="True" ItemClick="BookList_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="app:BookRow">
                    <!-- The list item's spoken name is BookRow.ToString() (AutomationName), which UI Automation uses for a data-bound item. -->
                    <Grid Padding="0,8" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12"
                          ToolTipService.ToolTip="{x:Bind PrimaryTooltip, Mode=OneWay}">
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="RowMenu_Opening">
                                <MenuFlyoutItem x:Uid="LibraryTagsMenuItem" Click="Tags_Click" />
                                <MenuFlyoutItem x:Uid="LibraryRemoveMenuItem" Click="Remove_Click" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <CheckBox Grid.Column="0" IsChecked="{x:Bind IsTicked, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center"
                                  Visibility="{x:Bind IsSelecting, Mode=OneWay}"
                                  AutomationProperties.Name="{x:Bind SelectName, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind MetaText, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <!-- The status shows only when the book is not ready (queued, indexing, rejected, failed). -->
                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Visibility="{x:Bind ShowStatus, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Reason, Mode=OneWay}" TextWrapping="Wrap"
                                       Visibility="{x:Bind ShowReason, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Note, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind HasNote, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl ItemsSource="{x:Bind Tags, Mode=OneWay}" Visibility="{x:Bind HasTags, Mode=OneWay}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VariableSizedWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Padding="10,2" Margin="0,0,6,4" CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <TextBlock Text="{x:Bind}" FontSize="12" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <!-- The row's one main action: Continue (accent, a book in progress), Read, or Open file for a book that is not ready.
                             The three have the same minimum width and centred text, so they line up from row to row. -->
                        <Button Grid.Column="2" Content="{x:Bind PrimaryLabel, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" MinWidth="100"
                                HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                Visibility="{x:Bind ShowContinueButton, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind PrimaryName, Mode=OneWay}" Click="Open_Click" />
                        <Button Grid.Column="2" Content="{x:Bind PrimaryLabel, Mode=OneWay}" MinWidth="100"
                                HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                Visibility="{x:Bind ShowReadButton, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind PrimaryName, Mode=OneWay}" Click="Open_Click" />
                        <Button Grid.Column="2" Content="{x:Bind PrimaryLabel, Mode=OneWay}" MinWidth="100"
                                HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                Visibility="{x:Bind ShowOpenFileButton, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind PrimaryName, Mode=OneWay}" Click="Open_Click" />
                        <!-- The "..." menu: Tags... and Remove. -->
                        <Button Grid.Column="3" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="8"
                                Visibility="{x:Bind ShowButtons, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind MenuName, Mode=OneWay}">
                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                            <Button.Flyout>
                                <MenuFlyout Opening="RowMenu_Opening">
                                    <MenuFlyoutItem x:Uid="LibraryTagsMenuItem" Click="Tags_Click" />
                                    <MenuFlyoutItem x:Uid="LibraryRemoveMenuItem" Click="Remove_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

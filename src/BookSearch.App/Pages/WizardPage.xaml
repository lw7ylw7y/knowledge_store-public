<Page
    x:Class="BookSearch.App.Pages.WizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wiz="using:BookSearch.App.Wizard">

    <Grid Padding="48,32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Step 1: privacy note -->
        <StackPanel Grid.Row="0" Spacing="16" MaxWidth="640" HorizontalAlignment="Left"
                    Visibility="{x:Bind ViewModel.IsPrivacyStep, Mode=OneWay}">
            <TextBlock x:Uid="WizardPrivacyTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="WizardPrivacyBody" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Step 2: hardware check and tier -->
        <StackPanel Grid.Row="0" Spacing="16" MaxWidth="640" HorizontalAlignment="Left"
                    Visibility="{x:Bind ViewModel.IsHardwareStep, Mode=OneWay}">
            <TextBlock x:Uid="WizardHardwareTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.RamText}" />
            <InfoBar x:Uid="WizardBelowMinimumBar" Severity="Warning" IsOpen="True"
                     Visibility="{x:Bind ViewModel.BelowMinimum}" />
            <ListView x:Name="TierList" x:Uid="WizardTierList" SelectionMode="Single" ItemsSource="{x:Bind ViewModel.TierOptions}"
                      SelectionChanged="TierList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="wiz:TierOption">
                        <StackPanel Padding="0,8" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="WizardRecommendedBadge" Visibility="{x:Bind IsRecommended}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- Step 3: download or import -->
        <StackPanel Grid.Row="0" Spacing="16" MaxWidth="640" HorizontalAlignment="Left"
                    Visibility="{x:Bind ViewModel.IsModelsStep, Mode=OneWay}">
            <TextBlock x:Uid="WizardModelsTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="WizardModelsBody" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="wiz:ModelRow">
                        <StackPanel Padding="0,8" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" />
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Percent, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
            <InfoBar x:Name="ErrorBar" Severity="Error" CloseButtonClick="ErrorBar_CloseButtonClick"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="WizardDownloadButton" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.DownloadCommand}" />
                <Button x:Uid="WizardCancelButton" Command="{x:Bind ViewModel.CancelCommand}"
                        IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}" />
                <Button x:Uid="WizardImportButton" Click="Import_Click" />
                <Button x:Uid="WizardAllowDownloadsButton" Command="{x:Bind ViewModel.AllowDownloadsCommand}"
                        Visibility="{x:Bind ViewModel.DownloadsBlocked, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <!-- Step 4: done -->
        <StackPanel Grid.Row="0" Spacing="16" MaxWidth="640" HorizontalAlignment="Left"
                    Visibility="{x:Bind ViewModel.IsDoneStep, Mode=OneWay}">
            <TextBlock x:Uid="WizardDoneTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="WizardDoneBody" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Navigation -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Uid="WizardBackButton" Command="{x:Bind ViewModel.BackCommand}"
                    Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" />
            <Button Content="{x:Bind ViewModel.NextLabel, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.NextCommand}"
                    Visibility="{x:Bind ViewModel.IsNotDoneStep, Mode=OneWay}" />
            <Button x:Uid="WizardFinishButton" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.FinishCommand}"
                    Visibility="{x:Bind ViewModel.IsDoneStep, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>

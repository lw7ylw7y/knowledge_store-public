<Page
    x:Class="BookSearch.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- One card per group of settings. -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock x:Uid="SettingsTitle" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Search and summaries -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="SettingsGroupSearch" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <NumberBox x:Uid="SettingsResultCountBox" Value="{x:Bind ViewModel.ResultCount, Mode=TwoWay}"
                               Minimum="{x:Bind ViewModel.MinResultCount}" Maximum="{x:Bind ViewModel.MaxResultCount}"
                               SpinButtonPlacementMode="Inline" SmallChange="1" MinWidth="240" HorizontalAlignment="Left" />
                    <NumberBox x:Uid="SettingsContextBox" Value="{x:Bind ViewModel.ContextQuestions, Mode=TwoWay}"
                               Minimum="{x:Bind ViewModel.MinContextQuestions}" Maximum="{x:Bind ViewModel.MaxContextQuestions}"
                               SpinButtonPlacementMode="Inline" SmallChange="1" MinWidth="240" HorizontalAlignment="Left" />
                    <TextBlock x:Uid="SettingsContextNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleSwitch x:Uid="SettingsSummarizeToggle" IsOn="{x:Bind ViewModel.AutoSummary, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="SettingsOtherLanguagesToggle" IsOn="{x:Bind ViewModel.SearchOtherLanguages, Mode=TwoWay}" />
                    <TextBlock x:Uid="SettingsOtherLanguagesNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Uid="SettingsSummaryContextBox" ItemsSource="{x:Bind ViewModel.ContextChoices}"
                              SelectedIndex="{x:Bind ViewModel.SummaryContextIndex, Mode=TwoWay}" MinWidth="240" />
                    <TextBlock x:Uid="SettingsSummaryContextNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Models -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="SettingsGroupModels" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Spacing="4">
                        <ComboBox x:Uid="SettingsTierHeader" ItemsSource="{x:Bind ViewModel.TierChoices}" DisplayMemberPath="Title"
                                  SelectedIndex="{x:Bind ViewModel.SelectedTierIndex, Mode=TwoWay}" MinWidth="240" />
                        <TextBlock Text="{x:Bind ViewModel.Tier}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Uid="SettingsTierNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Uid="SettingsDownloadsToggle" IsOn="{x:Bind ViewModel.DownloadsAllowed, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Indexing -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="SettingsGroupIndexing" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Slider x:Uid="SettingsCpuSlider" Value="{x:Bind ViewModel.CpuCap, Mode=TwoWay}"
                            Minimum="{x:Bind ViewModel.MinCpuPercent}" Maximum="{x:Bind ViewModel.MaxCpuPercent}"
                            StepFrequency="10" TickFrequency="10" TickPlacement="Outside" />
                </StackPanel>
            </Border>

            <!-- Advanced: expert options, folded away. Each says when it applies, if not at once. -->
            <Expander x:Uid="SettingsGroupAdvanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="16" Padding="0,8">
                    <StackPanel Spacing="4">
                        <ComboBox x:Uid="SettingsChatContextHeader" ItemsSource="{x:Bind ViewModel.ChatContextChoices}" DisplayMemberPath="Title"
                                  SelectedIndex="{x:Bind ViewModel.SelectedChatContextIndex, Mode=TwoWay}" MinWidth="240" />
                        <TextBlock Text="{x:Bind ViewModel.ChatContextNote, Mode=OneWay}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <NumberBox x:Uid="SettingsChunkTokensBox" Value="{x:Bind ViewModel.ChunkTokens, Mode=TwoWay}"
                               Minimum="{x:Bind ViewModel.MinChunkTokens}" Maximum="{x:Bind ViewModel.MaxChunkTokens}"
                               SpinButtonPlacementMode="Inline" SmallChange="50" MinWidth="240" HorizontalAlignment="Left" />
                    <NumberBox x:Uid="SettingsOverlapBox" Value="{x:Bind ViewModel.OverlapTokens, Mode=TwoWay}"
                               Minimum="{x:Bind ViewModel.MinOverlapTokens}" Maximum="{x:Bind ViewModel.MaxOverlapTokens}"
                               SpinButtonPlacementMode="Inline" SmallChange="5" MinWidth="240" HorizontalAlignment="Left" />
                    <TextBlock x:Uid="SettingsChunkNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Expander>

            <!-- Your data -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="SettingsGroupData" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel>
                        <TextBlock x:Uid="SettingsDataFolderLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DataFolder}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Uid="SettingsDatabaseLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Database}" />
                    </StackPanel>
                    <!-- A failed delete is reported here, next to the buttons, where the person is looking. -->
                    <InfoBar Severity="Error" CloseButtonClick="MessageBar_CloseButtonClick"
                             IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Message="{x:Bind ViewModel.Message, Mode=OneWay}" />
                    <Button x:Uid="SettingsClearHistoryButton" Command="{x:Bind ViewModel.ClearHistoryCommand}" />
                    <!-- Last and set apart: it cannot be undone. -->
                    <Button x:Uid="SettingsDeleteAllButton" Command="{x:Bind ViewModel.DeleteAllDataCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

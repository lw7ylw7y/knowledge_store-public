<Page
    x:Class="BookSearch.App.Pages.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:BookSearch.App"
    xmlns:rd="using:BookSearch.App.Reader"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.KeyboardAccelerators>
        <!-- Esc and Alt+Left leave the Reader, like Back. -->
        <KeyboardAccelerator Key="Escape" Invoked="Back_Invoked" />
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="Back_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Where we are -->
        <StackPanel Grid.Row="0" Spacing="2">
            <Button Content="{x:Bind ViewModel.BackText, Mode=OneWay}" Click="Back_Click" Margin="0,0,0,8" />
            <TextBlock Text="{x:Bind ViewModel.BookTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.Author, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.ChapterTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.PagesText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Chapter navigation and the original file -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button Grid.Column="0" x:Uid="ReaderPreviousButton" Command="{x:Bind ViewModel.PreviousChapterCommand}" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="2" x:Uid="ReaderNextButton" Command="{x:Bind ViewModel.NextChapterCommand}" />
            <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.FileMessage, Mode=OneWay}" VerticalAlignment="Center"
                       HorizontalAlignment="Right" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind ViewModel.HasFileMessage, Mode=OneWay}" />
            <Button Grid.Column="4" x:Uid="ReaderOpenFileButton" Command="{x:Bind ViewModel.OpenFileCommand}" />
        </Grid>

        <StackPanel Grid.Row="2" Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <InfoBar Severity="Error" CloseButtonClick="ErrorBar_CloseButtonClick"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
        </StackPanel>

        <!-- The chapter, one paragraph per row, so a long chapter stays quick and can be scrolled to the passage. -->
        <ListView x:Name="ParagraphList" x:Uid="ReaderParagraphList" Grid.Row="3" ItemsSource="{x:Bind ViewModel.Paragraphs, Mode=OneWay}"
                  SelectionMode="None" MaxWidth="820" HorizontalAlignment="Center">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="rd:ReaderParagraph">
                    <TextBlock app:ReaderText.Source="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               FontSize="16" LineHeight="26" Margin="0,4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\fixtures\**\*" Exclude="..\fixtures\**\*.py" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BookSearch.Core\BookSearch.Core.csproj" />
    <ProjectReference Include="..\..\src\BookSearch.Parsing\BookSearch.Parsing.csproj" />
    <ProjectReference Include="..\..\src\BookSearch.Models\BookSearch.Models.csproj" />
    <ProjectReference Include="..\..\src\BookSearch.App.Logic\BookSearch.App.Logic.csproj" />
  </ItemGroup>

</Project>
